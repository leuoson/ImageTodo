{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImageTodo",
  "version": "0.1.0",
  "identifier": "com.imagetodo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self';"
    },
    "windows": [
      {
        "label": "main",
        "title": "ImageTodo",
        "width": 320,
        "height": 400,
        "minHeight": 320,
        "minWidth": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
